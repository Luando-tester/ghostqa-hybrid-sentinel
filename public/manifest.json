{
  "manifest_version": 3,
  "name": "GhostQA Local-First Sentinel",
  "version": "1.0.0",
  "description": "Hybrid On-Device & Cloud AI QA Auditor powered by Firebase AI Logic.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://firebasevertexai.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "GhostQA Sentinel"
  }
}